{
  "name": "@dfosco/tiny-canvas",
  "version": "5.3.0",
  "type": "module",
  "license": "MIT",
  "description": "A lightweight React canvas with draggable elements and persistent positions",
  "keywords": [
    "canvas",
    "drag-and-drop",
    "draggable",
    "react",
    "whiteboard"
  ],
  "homepage": "https://dfosco.github.io/tiny-canvas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfosco/tiny-canvas.git",
    "directory": "packages/tiny-canvas"
  },
  "bugs": {
    "url": "https://github.com/dfosco/tiny-canvas/issues"
  },
  "main": "./dist/tiny-canvas.js",
  "module": "./dist/tiny-canvas.js",
  "types": "./src/index.d.ts",
  "style": "./dist/tiny-canvas.css",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/tiny-canvas.js",
      "default": "./dist/tiny-canvas.js"
    },
    "./style.css": "./dist/tiny-canvas.css",
    "./vite": {
      "types": "./src/vite.d.ts",
      "import": "./src/vite.js",
      "default": "./src/vite.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "src/pageRoute.js",
    "src/vite.js",
    "src/vite.d.ts",
    "src/virtual.d.ts",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@neodrag/react": "^2.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
